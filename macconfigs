#!/usr/bin/env bash
set -euo pipefail

echo "==> Applying macOS defaults"

# Instant dock autohide (no animation delay)
defaults write com.apple.dock autohide-time-modifier -int 0

# Screenshots: JPG format, save to ~/Pictures
defaults write com.apple.screencapture type JPG
defaults write com.apple.screencapture location ~/Pictures

# Disable press-and-hold for keys (enable key repeat)
defaults write -g ApplePressAndHoldEnabled -bool false

# Auto-hide native menu bar (required for sketchybar to be visible)
defaults write NSGlobalDomain _HIHideMenuBar -bool true

# Disable auto-rearranging Spaces based on recent use
defaults write com.apple.dock mru-spaces -bool false

killall Dock

echo "  Done. Some changes may require a logout to take effect."
