# Hyper = caps lock held (Karabiner sends right ctrl+opt+cmd). See KEYMAP.md.
# Keycodes: 0x21 = [  0x1E = ]  0x2B = ,  0x2F = .

# Changing between layouts

ctrl + alt + cmd - b : yabai -m space --layout bsp
ctrl + alt + cmd - s : yabai -m space --layout stack
shift + ctrl + alt + cmd - space : yabai -m space --layout float

# Changing Window Focus

# Change window focus within spaces (j/k cycle the stack in stack layout)
ctrl + alt + cmd - j : yabai -m window --focus south || yabai -m window --focus stack.next
ctrl + alt + cmd - k : yabai -m window --focus north || yabai -m window --focus stack.prev
ctrl + alt + cmd - h : yabai -m window --focus west
ctrl + alt + cmd - l : yabai -m window --focus east

# Change focus between displays
ctrl + alt + cmd - 0x2B : yabai -m display --focus west
ctrl + alt + cmd - 0x2F : yabai -m display --focus east

# Modifying the Layout

ctrl + alt + cmd - r : yabai -m space --rotate 270

ctrl + alt + cmd - y : yabai -m space --mirror y-axis
ctrl + alt + cmd - x : yabai -m space --mirror x-axis

ctrl + alt + cmd - space : yabai -m window --toggle float --grid 4:4:1:1:2:2

# Modifying Window Size

ctrl + alt + cmd - f : yabai -m window --toggle zoom-fullscreen
ctrl + alt + cmd - e : yabai -m space --balance

# Moving Windows Around

shift + ctrl + alt + cmd - j : yabai -m window --swap south
shift + ctrl + alt + cmd - k : yabai -m window --swap north
shift + ctrl + alt + cmd - h : yabai -m window --swap west
shift + ctrl + alt + cmd - l : yabai -m window --swap east

# Move window to display left and right
shift + ctrl + alt + cmd - 0x2B : yabai -m window --display west; yabai -m display --focus west;
shift + ctrl + alt + cmd - 0x2F : yabai -m window --display east; yabai -m display --focus east;

# Move window to prev and next space
shift + ctrl + alt + cmd - 0x21 : yabai -m window --space prev;
shift + ctrl + alt + cmd - 0x1E : yabai -m window --space next;

# Switch between spaces

ctrl + alt + cmd - 0x21 : yabai -m space --focus prev;
ctrl + alt + cmd - 0x1E : yabai -m space --focus next;

ctrl + alt + cmd - 1 : yabai -m space --focus 1;
ctrl + alt + cmd - 2 : yabai -m space --focus 2;
ctrl + alt + cmd - 3 : yabai -m space --focus 3;
ctrl + alt + cmd - 4 : yabai -m space --focus 4;
ctrl + alt + cmd - 5 : yabai -m space --focus 5;
ctrl + alt + cmd - 6 : yabai -m space --focus 6;
ctrl + alt + cmd - 7 : yabai -m space --focus 7;
ctrl + alt + cmd - 8 : yabai -m space --focus 8;
ctrl + alt + cmd - 9 : yabai -m space --focus 9;

# Move window to space
shift + ctrl + alt + cmd - 1 : yabai -m window --space 1;
shift + ctrl + alt + cmd - 2 : yabai -m window --space 2;
shift + ctrl + alt + cmd - 3 : yabai -m window --space 3;
shift + ctrl + alt + cmd - 4 : yabai -m window --space 4;
shift + ctrl + alt + cmd - 5 : yabai -m window --space 5;
shift + ctrl + alt + cmd - 6 : yabai -m window --space 6;
shift + ctrl + alt + cmd - 7 : yabai -m window --space 7;
shift + ctrl + alt + cmd - 8 : yabai -m window --space 8;
shift + ctrl + alt + cmd - 9 : yabai -m window --space 9;

# Start/Stop yabai
ctrl + alt - q : brew services stop yabai
ctrl + alt - s : brew services start yabai
