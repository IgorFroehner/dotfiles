layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
        children
    }
    tab name="#1 nvim" {
        pane {
            command "nvim"
            args "."
        }
    }
    tab name="#2 AI" {
        pane stacked=true {
            pane
        }
    }
    tab name="#3 terminals" {
        pane split_direction="vertical" {
            pane
            pane 
        }
    }
    tab name="#4 rails" {
        pane {
            command "bin/dev"
            start_suspended true
        }
    }
    tab name="#5 docker" {
        pane {
            command "bash"
            args "-c" "trap 'docker-compose down' EXIT; docker-compose up"
        }
    }
}
