layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
        children
    }
    tab name="nvim" {
        pane {
            command "nvim"
            args "."
        }
    }
    tab name="AI" {
        pane stacked=true {
            pane
        }
    }
    tab name="terminals" {
        pane split_direction="vertical" {
            pane
            pane 
        }
    }
    tab name="rails" {
        pane {
            command "bin/dev"
            start_suspended true
        }
    }
    tab name="docker" {
        pane {
            command "bash"
            args "-c" "trap 'docker-compose down' EXIT; docker-compose up"
        }
    }
}
