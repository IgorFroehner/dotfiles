#!/usr/bin/env sh

# Scripting addition: requires a passwordless sudoers entry for `yabai --load-sa`
yabai -m signal --add label=load_sa event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

PAD=9

yabai -m config \
	layout             stack \
	window_placement   second_child \
	top_padding        $PAD \
	bottom_padding     $PAD \
	left_padding       $PAD \
	right_padding      $PAD \
	window_gap         $PAD \
	mouse_modifier     alt \
	mouse_action1      move \
	mouse_action2      resize \
	mouse_drop_action  swap \
	external_bar       all:38:0 # must match bar_height in sketchybar/settings.lua

# Unmanaged apps
yabai -m rule --add label=settings   app="^System Settings$"    manage=off
yabai -m rule --add label=calculator app="^Calculator$"         manage=off
yabai -m rule --add label=karabiner  app="^Karabiner-(Elements|EventViewer)$" manage=off

# System utilities
yabai -m rule --add label=utilities app="^(Archive Utility|Activity Monitor|System Information|Installer)$" manage=off
yabai -m rule --add label=finder_dialogs app="^Finder$" title="^(Copy|Move|Connect to Server|.* Info)$" manage=off

# Menubar / tool apps
yabai -m rule --add label=tools app="^(1Password|Raycast|Logi Options\+|logioptionsplus|Mos|Pritunl)$" manage=off

# Zoom: tile only the main windows, float toolbars and popups
yabai -m rule --add label=zoom app="^zoom\.us$" title!="^(Zoom Meeting|Zoom Workplace)$" manage=off

yabai -m rule --apply
